{
  "name": "opencode-vscode",
  "displayName": "opencode",
  "description": "AI coding assistant powered by opencode — chat with your codebase from the sidebar.",
  "version": "0.0.1",
  "publisher": "opencode-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/opencode-dev/opencode-vscode"
  },
  "categories": [
    "Machine Learning",
    "Chat",
    "Other"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:opencode.chatView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "opencode.startChat",
        "title": "opencode: Start Chat",
        "category": "opencode"
      },
      {
        "command": "opencode.newSession",
        "title": "opencode: New Session",
        "category": "opencode"
      }
    ],
    "keybindings": [
      {
        "command": "opencode.startChat",
        "key": "ctrl+shift+alt+o",
        "mac": "cmd+shift+alt+o"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode-sidebar",
          "title": "opencode",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "opencode-sidebar": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "opencode",
      "properties": {
        "opencode.port": {
          "type": "number",
          "default": 4096,
          "description": "Port for the opencode server"
        },
        "opencode.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the opencode binary. Leave empty to use PATH."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "vite build --config vite.config.mts",
    "build:ext": "node esbuild.mjs",
    "build": "npm run build:webview && npm run build:ext",
    "watch": "node esbuild.mjs --watch",
    "package": "npx vsce package",
    "gen:api": "node scripts/gen-api.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.0.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "svelte": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
