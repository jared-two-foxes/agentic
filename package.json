{
  "name": "opencode-vscode",
  "displayName": "opencode",
  "description": "opencode VSCode extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:opencode.chatView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "opencode.open",
        "title": "Open opencode"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode-sidebar",
          "title": "opencode",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "opencode-sidebar": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "Chat"
        }
      ]
    }
  },
  "scripts": {
    "build:webview": "vite build --config vite.config.mts",
    "build:ext": "node esbuild.mjs",
    "build": "npm run build:webview && npm run build:ext",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "svelte": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
