{
  "name": "opencode-vscode",
  "displayName": "opencode",
  "description": "AI coding assistant powered by opencode — chat with your codebase from the sidebar.",
  "version": "0.0.1",
  "publisher": "opencode-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/opencode-dev/opencode-vscode"
  },
  "categories": [
    "Machine Learning",
    "Chat",
    "Other"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:opencode.chatView"
  ],
  "contributes": {
    "commands": [
      {
        "command": "opencode.startChat",
        "title": "opencode: Start Chat",
        "category": "opencode"
      },
      {
        "command": "opencode.newSession",
        "title": "opencode: New Session",
        "category": "opencode",
        "icon": "$(add)"
      },
      {
        "command": "opencode.maximizeChat",
        "title": "opencode: Open in Editor",
        "category": "opencode",
        "icon": "$(screen-full)"
      },
      {
        "command": "opencode.minimizeChat",
        "title": "Minimize Chat",
        "icon": "$(screen-normal)",
        "category": "opencode"
      },
      {
        "command": "opencode.configureProvider",
        "title": "opencode: Configure AI Provider",
        "category": "opencode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencode.newSession",
          "when": "view == opencode.chatView",
          "group": "navigation"
        },
        {
          "command": "opencode.maximizeChat",
          "when": "view == opencode.chatView",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "opencode.minimizeChat",
          "when": "activeWebviewPanelId == 'opencode.chatEditor'",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.startChat",
        "key": "ctrl+shift+alt+o",
        "mac": "cmd+shift+alt+o"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode-sidebar",
          "title": "opencode",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "opencode-sidebar": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "opencode",
      "properties": {
        "opencode.provider": {
          "type": "string",
          "enum": ["vscode-lm", "anthropic", "openai-compatible"],
          "default": "vscode-lm",
          "description": "LLM provider to use. 'vscode-lm' uses GitHub Copilot (no API key needed). 'anthropic' calls Anthropic directly. 'openai-compatible' works with OpenAI, Ollama, LM Studio, Azure, and any OpenAI-compatible API."
        },
        "opencode.anthropicModel": {
          "type": "string",
          "default": "claude-opus-4-5",
          "description": "Anthropic model to use (e.g. claude-opus-4-5, claude-sonnet-4-5)"
        },
        "opencode.openaiBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for OpenAI-compatible API (e.g. http://localhost:11434/v1 for Ollama)"
        },
        "opencode.openaiModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Model to use for OpenAI-compatible provider"
        },
        "opencode.autoApprove.fileWrites": {
          "type": "boolean",
          "default": false,
          "description": "Automatically approve file write/edit tool calls without prompting."
        },
        "opencode.autoApprove.commands": {
          "type": "boolean",
          "default": false,
          "description": "Automatically approve shell command tool calls (bash) without prompting."
        },
        "opencode.autoApprove.fileReads": {
          "type": "boolean",
          "default": true,
          "description": "Automatically approve file read tool calls (read, glob, grep) without prompting."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "vite build --config vite.config.mts",
    "build:ext": "node esbuild.mjs",
    "build": "npm run build:webview && npm run build:ext",
    "watch": "node esbuild.mjs --watch",
    "package": "npx vsce package",
    "gen:api": "node scripts/gen-api.mjs",
    "copy:codicon": "node -e \"require('fs').copyFileSync('node_modules/@vscode/codicons/dist/codicon.ttf','webview/public/codicon.ttf')\""
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.36",
    "esbuild": "^0.20.0",
    "openapi-typescript": "^7.0.0",
    "svelte": "^4.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "dompurify": "^3.4.5",
    "marked": "^18.0.4",
    "shiki": "^4.1.0"
  }
}
